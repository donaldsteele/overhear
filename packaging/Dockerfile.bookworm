FROM debian:12
RUN dpkg --add-architecture arm64 && apt-get update && apt-get install -y --no-install-recommends \
      build-essential gcc-aarch64-linux-gnu libc6-dev-arm64-cross binutils-aarch64-linux-gnu \
      libpcap0.8-dev libpcap0.8-dev:arm64 pkg-config ca-certificates curl perl \
    && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.99.0 \
      --target aarch64-unknown-linux-gnu && chmod -R a+rX /opt/rustup /opt/cargo
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc PKG_CONFIG_ALLOW_CROSS=1
RUN cargo install cargo-deb --locked && chmod -R a+rX /opt/cargo
